# mediaflow production configuration.
# Secrets are NEVER stored here. Put them in /etc/mediaflow/tmdb.env and
# /etc/mediaflow/notify.env (root:mediaflow, 0640).
#
# Reload behaviour is defined once in mediaflow.config.KEY_CLASS:
#   restart-required: root, state_dir, runtime_dir, ffmpeg, poll_seconds,
#                     review_reminder_days, notify_cooldown_hours
#   future-jobs:      append_tmdbid, stall_minutes, temp_sensor
#   live:             all other keys
# Restart-required keys keep their old effective value until the daemon is
# restarted; status reports the pending hold. Secret files reload only on
# restart. See docs/SPEC.md section 10.1.

root = "/srv/media"
ffmpeg = "/usr/lib/jellyfin-ffmpeg/ffmpeg"
ffprobe = "/usr/lib/jellyfin-ffmpeg/ffprobe"
dry_run = true
poll_seconds = 30
stable_seconds = 120
trash_retention_days = 14
failed_retention_days = 30
min_free_gb = 40
root_min_free_gb = 2
max_trash_gb = 120
space_watchdog_seconds = 60
append_tmdbid = false
pause_when_jellyfin_transcoding = true
pause_on_battery = true
pause_method = "sigstop"
temp_sensor = "auto"
start_if_temp_below_c = 65
thermal_pause_c = 85
thermal_resume_c = 75
progress_seconds = 30
stall_minutes = 10
max_restarts = 3
min_output_kbps = 300
# Quality floor in bits per pixel per frame (video payload bits divided by
# presented frames x width x height).  0.01 is about 498 kbps at 1080p24 and
# is a placeholder: calibrate it on real content before trusting it.
min_bpp = 0.01
review_reminder_days = 3
notify_cooldown_hours = 6
jellyfin_user = "jellyfin"
state_dir = "/var/lib/mediaflow"
runtime_dir = "/run/mediaflow"
